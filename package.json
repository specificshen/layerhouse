{
  "name": "layerhouse",
  "version": "1.0.0",
  "description": "层宅 / Layer House — original Three.js architectural viewer, Bun + TypeScript",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun src/index.html --port=5173",
    "check": "bun check",
    "fmt": "bun fmt",
    "test": "bun test",
    "build": "bun build --compile --target=browser --minify ./src/index.html --outdir=dist"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0"
  },
  "patchedDependencies": {
    "three@0.187.0": "patches/three@0.187.0.patch"
  }
}
